{
  "name": "universal-visual-ui-builder",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "test:desktop": "node --test desktop/security.test.cjs",
    "desktop": "npm run build && electron .",
    "package:win": "node scripts/Prepare-Manifest.cjs && npm run build && electron-builder --win --x64 --publish never",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/Build-Release.ps1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.7.3",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  },
  "description": "Forma - local visual interface builder for Windows and the web",
  "author": {
    "name": "TikTak-creator",
    "url": "https://github.com/TikTak-creator"
  },
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
